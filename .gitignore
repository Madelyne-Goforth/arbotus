__pycache__/
*.pyc
.venv/
venv/

# Vector store data (large, regenerable from docs_raw/ -- not source)
data/

# Raw doctrine text (.txt, extracted from public-domain U.S. government
# publications -- shipped in the repo on purpose, so the project is
# usable on download without a separate extraction pass. Original PDFs
# are NOT committed (large, and easy to re-download from armypubs.army.mil).
docs_raw/*.pdf

